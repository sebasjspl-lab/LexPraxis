{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "http" }],
      "destination": "https://www.lexpraxis.co/$1",
      "permanent": true
    },
    {
      "source": "/noticias/suspension-provisional-petro-2026",
      "destination": "/actualidad-juridica",
      "permanent": true
    },
    {
      "source": "/noticias/:slug",
      "destination": "/actualidad-juridica/:slug",
      "permanent": true
    },
    {
      "source": "/noticias",
      "destination": "/actualidad-juridica",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/ley-599",        "destination": "/index.html" },
    { "source": "/ley-906",        "destination": "/index.html" },
    { "source": "/ley-1826",       "destination": "/index.html" },
    { "source": "/ley-1098",       "destination": "/index.html" },
    { "source": "/ley-600",        "destination": "/index.html" },
    { "source": "/jurisprudencia", "destination": "/index.html" },
    { "source": "/herramientas",   "destination": "/index.html" },
    { "source": "/sobre",          "destination": "/index.html" },
    { "source": "/actualidad-juridica",       "destination": "/actualidad-juridica/index.html" },
    { "source": "/actualidad-juridica/:slug", "destination": "/actualidad-juridica/:slug.html" },
    { "source": "/lineas",         "destination": "/lineas/index.html" },
    { "source": "/lineas/:slug",   "destination": "/lineas/:slug.html" },
    { "source": "/(.*)",           "destination": "/index.html" }
  ]
}
